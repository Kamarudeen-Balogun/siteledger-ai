{
  "name": "siteledger-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepare:production-demo": "node --env-file=.env.local --conditions=react-server --import tsx scripts/prepare-production-demo.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/check-database.mjs",
    "test:telegram": "node --conditions=react-server --import tsx --test tests/telegram.test.ts",
    "db:check-telegram": "node scripts/check-database.mjs tests/telegram.sql",
    "setup:verify": "node scripts/verify-setup.mjs",
    "telegram:set-webhook": "node scripts/set-telegram-webhook.mjs",
    "test:ai": "node --conditions=react-server --import tsx --test tests/ai.test.ts",
    "ai:process": "node --conditions=react-server --import tsx scripts/process-ai-submissions.mjs",
    "db:check-ai": "node scripts/check-database.mjs tests/ai.sql",
    "test:confirm": "node --conditions=react-server --import tsx --test tests/confirm.test.ts",
    "db:check-confirm": "node scripts/check-database.mjs tests/confirm.sql",
    "telegram:configure-menu": "node scripts/configure-telegram-menu.mjs",
    "test:costing": "node --import tsx --test tests/costing.test.ts tests/money-display.test.ts",
    "test:reports": "node --conditions=react-server --import tsx --test tests/reports.test.ts",
    "db:check-reports": "node scripts/check-database.mjs tests/reports.sql",
    "test:report-browser": "node scripts/verify-account-browser.mjs",
    "test:log": "node --conditions=react-server --import tsx --test tests/log.test.ts",
    "db:check-log": "node scripts/check-database.mjs tests/log.sql",
    "test:log-browser": "node scripts/verify-account-browser.mjs",
    "test:photos": "node --conditions=react-server --import tsx --test tests/photos.test.ts",
    "db:check-photos": "node scripts/check-database.mjs tests/photos.sql",
    "test:photos-browser": "node scripts/verify-account-browser.mjs",
    "test:photos-demo-browser": "node scripts/verify-account-browser.mjs",
    "ai:analyse-demo-photos": "node --env-file=.env.local --conditions=react-server --import tsx scripts/analyse-demo-photos.ts",
    "test:web": "node --conditions=react-server --import tsx --test tests/web.test.ts",
    "db:check-web": "node scripts/check-database.mjs tests/web.sql",
    "test:web-browser": "node scripts/verify-account-browser.mjs",
    "db:check-account-identity": "node scripts/check-database.mjs tests/account-identity.sql",
    "test:account": "node --conditions=react-server --import tsx --test tests/account.test.ts",
    "db:check-account-projects": "node scripts/check-database.mjs tests/account-projects.sql",
    "preview:account-emails": "node scripts/preview-account-emails.mjs",
    "db:check-account-records": "node scripts/check-database.mjs tests/account-records.sql",
    "db:check-account-telegram": "node scripts/check-database.mjs tests/account-telegram.sql",
    "db:check-account-web": "node scripts/check-database.mjs tests/account-web.sql",
    "test:account-browser": "node scripts/verify-account-browser.mjs",
    "test:dashboard": "node --conditions=react-server --import tsx --test tests/dashboard.test.ts",
    "db:check-dashboard": "node scripts/check-database.mjs tests/dashboard.sql",
    "db:check-fresh": "node scripts/check-fresh-database.mjs && node scripts/check-fresh-database.mjs --legacy"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "big.js": "^7.0.1",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.20",
    "server-only": "^0.0.1",
    "unzipper-esm": "^0.13.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
