{
  "name": "siteledger-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/check-database.mjs",
    "test:telegram": "node --conditions=react-server --import tsx --test tests/telegram.test.ts",
    "db:check-telegram": "node scripts/check-database.mjs tests/telegram.sql",
    "setup:verify": "node scripts/verify-setup.mjs",
    "telegram:set-webhook": "node scripts/set-telegram-webhook.mjs",
    "test:ai": "node --conditions=react-server --import tsx --test tests/ai.test.ts",
    "ai:process": "node --conditions=react-server --import tsx scripts/process-ai-submissions.mjs",
    "db:check-ai": "node scripts/check-database.mjs tests/ai.sql",
    "test:confirm": "node --conditions=react-server --import tsx --test tests/confirm.test.ts",
    "db:check-confirm": "node scripts/check-database.mjs tests/confirm.sql",
    "telegram:configure-menu": "node scripts/configure-telegram-menu.mjs",
    "test:costing": "node --import tsx --test tests/costing.test.ts",
    "test:reports": "node --conditions=react-server --import tsx --test tests/reports.test.ts",
    "db:check-reports": "node scripts/check-database.mjs tests/reports.sql",
    "test:report-browser": "node --conditions=react-server --import tsx --test tests/report-browser.test.ts",
    "test:log": "node --conditions=react-server --import tsx --test tests/log.test.ts",
    "db:check-log": "node scripts/check-database.mjs tests/log.sql",
    "test:log-browser": "node scripts/verify-log-browser.mjs",
    "test:photos": "node --conditions=react-server --import tsx --test tests/photos.test.ts",
    "db:check-photos": "node scripts/check-database.mjs tests/photos.sql",
    "test:photos-browser": "node scripts/verify-log-browser.mjs photos",
    "test:photos-demo-browser": "node scripts/verify-log-browser.mjs photos-demo",
    "ai:analyse-demo-photos": "node --env-file=.env.local --conditions=react-server --import tsx scripts/analyse-demo-photos.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "big.js": "^7.0.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
